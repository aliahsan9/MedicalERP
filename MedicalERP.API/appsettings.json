  "ConnectionStrings": {
    "DefaultConnection": "Server=DESKTOP-GVA6N7B\\SQLEXPRESS;Database=MedicalERPDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "THIS_IS_SUPER_SECRET_KEY_CHANGE_ITSUPER_SECRET_KEY_CHANGE_IT",
    "Issuer": "MedicalERP",
